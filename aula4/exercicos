#include <stdio.h>

#define MAX 100

typedef struct {
    int id;
    int pontos;
} Jogador;

int main() {
    Jogador jogadores[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n1 - Cadastrar jogador\n");
        printf("2 - Buscar jogador por ID\n");
        printf("3 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                printf("ID do jogador: ");
                scanf("%d", &jogadores[total].id);
                printf("Pontos: ");
                scanf("%d", &jogadores[total].pontos);
                total++;
            } else {
                printf("Limite de jogadores atingido.\n");
            }
        } else if (opcao == 2) {
            int idBusca, encontrado = 0;
            printf("Digite o ID a buscar: ");
            scanf("%d", &idBusca);
            for (int i = 0; i < total; i++) {
                if (jogadores[i].id == idBusca) {
                    printf("Jogador encontrado! Pontos: %d\n", jogadores[i].pontos);
                    encontrado = 1;
                    break;
                }
            }
            if (!encontrado) {
                printf("Jogador nao encontrado.\n");
            }
        }
    } while (opcao != 3);

    return 0;
}





