#include <stdio.h>

#define MAX 100

typedef struct {
    int numeroCasa;
    float consumoKwh;
} Imovel;

int main() {
    Imovel imoveis[MAX];
    int total = 0;
    int opcao;
    float media = 0;

    do {
        printf("\n1 - Cadastrar imovel\n");
        printf("2 - Calcular media de consumo da rua\n");
        printf("3 - Listar imoveis acima da media\n");
        printf("4 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                printf("Numero da casa: ");
                scanf("%d", &imoveis[total].numeroCasa);
                printf("Consumo em kWh: ");
                scanf("%f", &imoveis[total].consumoKwh);
                total++;
            } else {
                printf("Limite de imoveis atingido.\n");
            }
        } else if (opcao == 2) {
            if (total == 0) {
                printf("Nenhum imovel cadastrado.\n");
            } else {
                float soma = 0;
                for (int i = 0; i < total; i++) {
                    soma += imoveis[i].consumoKwh;
                }
                media = soma / total;
                printf("Media de consumo da rua: %.2f kWh\n", media);
            }
        } else if (opcao == 3) {
            for (int i = 0; i < total; i++) {
                if (imoveis[i].consumoKwh > media) {
                    printf("Casa: %d | Consumo: %.2f kWh\n", imoveis[i].numeroCasa, imoveis[i].consumoKwh);
                }
            }
        }
    } while (opcao != 4);

    return 0;
}

