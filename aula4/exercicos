#include <stdio.h>

#define MAX 100

typedef struct {
    int codigo;
    float peso;
    float altura;
} Perfil;

int main() {
    Perfil perfis[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n1 - Cadastrar aluno\n");
        printf("2 - Exibir aluno mais alto\n");
        printf("3 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                printf("Codigo: ");
                scanf("%d", &perfis[total].codigo);
                printf("Peso: ");
                scanf("%f", &perfis[total].peso);
                printf("Altura: ");
                scanf("%f", &perfis[total].altura);
                total++;
            } else {
                printf("Limite de alunos atingido.\n");
            }
        } else if (opcao == 2) {
            if (total == 0) {
                printf("Nenhum aluno cadastrado.\n");
