#include <stdio.h>

#define MAX 100

typedef struct {
    int codigo;
    int idade;
    char telefone[15];
} Cliente;

int main() {
    Cliente clientes[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n1 - Cadastrar cliente\n");
        printf("2 - Listar clientes\n");
        printf("3 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                printf("Codigo: ");
                scanf("%d", &clientes[total].codigo);
                printf("Idade: ");
                scanf("%d", &clientes[total].idade);
                printf("Telefone: ");
                scanf("%s", clientes[total].telefone);
                total++;
            } else {
                printf("Limite de clientes atingido.\n");
            }
        } else if (opcao == 2) {
            for (int i = 0; i < total; i++) {
                printf("Codigo: %d | Idade: %d | Telefone: %s\n",
                       clientes[i].codigo, clientes[i].idade, clientes[i].telefone);
            }
        }
    } while (opcao != 3);

    return 0;
}
