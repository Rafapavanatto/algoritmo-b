#include <stdio.h>

#define MAX 100

typedef struct {
    int numeroConta;
    float saldo;
} Conta;

int main() {
    Conta contas[MAX];
    int total = 0;
    int opcao;

    do {
        printf("\n1 - Cadastrar conta\n");
        printf("2 - Depositar\n");
        printf("3 - Mostrar todas as contas\n");
        printf("4 - Sair\n");
        printf("Opcao: ");
        scanf("%d", &opcao);

        if (opcao == 1) {
            if (total < MAX) {
                printf("Numero da conta: ");
                scanf("%d", &contas[total].numeroConta);
                printf("Saldo inicial: ");
                scanf("%f", &contas[total].saldo);
                total++;
            } else {
                printf("Limite de contas atingido.\n");
            }
        } else if (opcao == 2) {
            if (total == 0) {
                printf("Nenhuma conta cadastrada.\n");
            } else {
                int indice;
                float valor;
                printf("Indice da conta (0 a %d): ", total - 1);
                scanf("%d", &indice);
                if (indice >= 0 && indice < total) {
                    printf("Valor a depositar: ");
                    scanf("%f", &valor);
                    contas[indice].saldo += valor;
                } else {
                    printf("Indice invalido.\n");
                }
            }
        } else if (opcao == 3) {
            for (int i = 0; i < total; i++) {
                printf("Conta: %d | Saldo: R$ %.2f\n", contas[i].numeroConta, contas[i].saldo);
            }
        }
    } while (opcao != 4);

    return 0;
}

