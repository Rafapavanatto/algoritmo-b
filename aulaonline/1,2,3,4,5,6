#include <stdio.h>
#include <string.h>
#include <stdlib.h>
#include <ctype.h>

int soDigitos(char s[]) {
    if (s[0] == '\0') return 0;
    for (int i = 0; s[i] != '\0'; i++) {
        if (!isdigit((unsigned char)s[i])) return 0;
    }
    return 1;
}

void validarData(char dia[], char mes[], char ano[]) {
    if (!soDigitos(dia) || !soDigitos(mes) || !soDigitos(ano)) {
        printf("DATA INVÁLIDA\n");
        return;
    }

    int d = atoi(dia);
    int m = atoi(mes);
    int a = atoi(ano);

    if (a < 1 || m < 1 || m > 12 || d < 1) {
        printf("DATA INVÁLIDA\n");
        return;
    }

    int diasNoMes;
    switch (m) {
        case 4: case 6: case 9: case 11:
            diasNoMes = 30;
            break;
        case 2:
            diasNoMes = ((a % 4 == 0 && a % 100 != 0) || (a % 400 == 0)) ? 29 : 28;
            break;
        default:
            diasNoMes = 31;
    }

    if (d <= diasNoMes) {
        printf("DATA VÁLIDA\n");
    } else {
        printf("DATA INVÁLIDA\n");
    }
}

int main() {
    char dia[20], mes[20], ano[20];

    printf("Dia: ");
    scanf("%19s", dia);
    printf("Mês: ");
    scanf("%19s", mes);
    printf("Ano: ");
    scanf("%19s", ano);

    validarData(dia, mes, ano);
    return 0;
}
