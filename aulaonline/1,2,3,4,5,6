#include <stdio.h>
#include <string.h>
#include <ctype.h>

void contarLetra(char palavra[], char letra) {
    int cont = 0;
    for (int i = 0; palavra[i] != '\0'; i++) {
        if (tolower((unsigned char)palavra[i]) == tolower((unsigned char)letra)) {
            cont++;
        }
    }
    printf("A letra '%c' aparece %d vez(es).\n", letra, cont);
}

int main() {
    char palavra[100];
    char letra;

    printf("Palavra: ");
    fgets(palavra, sizeof(palavra), stdin);
    palavra[strcspn(palavra, "\n")] = '\0';

    printf("Letra: ");
    scanf(" %c", &letra);

    contarLetra(palavra, letra);
    return 0;
}
