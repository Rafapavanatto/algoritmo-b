#include <stdio.h>
#include <string.h>

char* primeiroNome(char nomeCompleto[], char resultado[]) {
    int i = 0;
    while (nomeCompleto[i] == ' ') i++;

    int j = 0;
    while (nomeCompleto[i] != '\0' && nomeCompleto[i] != ' ') {
        resultado[j++] = nomeCompleto[i++];
    }
    resultado[j] = '\0';
    return resultado;
}

int main() {
    char nomeCompleto[100], resultado[100];

    printf("Nome completo: ");
    fgets(nomeCompleto, sizeof(nomeCompleto), stdin);
    nomeCompleto[strcspn(nomeCompleto, "\n")] = '\0';

    printf("Primeiro nome: %s\n", primeiroNome(nomeCompleto, resultado));
    return 0;
}
