#include <stdio.h>
#include <string.h>
#include <ctype.h>

char* paraMaiuscula(char frase[]) {
    for (int i = 0; frase[i] != '\0'; i++) {
        frase[i] = toupper((unsigned char)frase[i]);
    }
    return frase;
}

int main() {
    char frase[200];

    printf("Frase: ");
    fgets(frase, sizeof(frase), stdin);
    frase[strcspn(frase, "\n")] = '\0';

    printf("%s\n", paraMaiuscula(frase));
    return 0;
}
